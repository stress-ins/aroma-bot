[Unit]
Description=Aroma Mini App Service
After=network.target

[Service]
WorkingDirectory=/opt/aroma
EnvironmentFile=/opt/aroma/.env
ExecStart=/opt/aroma/.venv/bin/gunicorn miniapp_server:app \
  -k uvicorn.workers.UvicornWorker \
  --workers 1 \
  --bind 127.0.0.1:8091 \
  --graceful-timeout 30 \
  --timeout 300
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3
User=root
# Prevent FFmpeg OOM from killing the entire service
MemoryMax=2500M
MemorySwapMax=512M
OOMPolicy=continue

[Install]
WantedBy=multi-user.target

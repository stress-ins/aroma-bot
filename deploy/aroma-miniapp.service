[Unit]
Description=Aroma Mini App Service
After=network.target

[Service]
WorkingDirectory=/opt/aroma
EnvironmentFile=/opt/aroma/.env
ExecStart=/opt/aroma/.venv/bin/gunicorn miniapp_server:app \
  -k uvicorn.workers.UvicornWorker \
  --workers 1 \
  --bind 127.0.0.1:8091 \
  --graceful-timeout 15 \
  --timeout 120
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3
# Startup timeout
TimeoutStartSec=30
# WatchdogSec disabled — gunicorn does not send sd_notify heartbeats
WatchdogSec=0
User=root
# Prevent FFmpeg OOM from killing the entire service
MemoryMax=2500M
MemorySwapMax=512M
OOMPolicy=continue
# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/aroma /tmp

[Install]
WantedBy=multi-user.target

[Unit]
Description=Aroma Mini App Service
After=network.target

[Service]
WorkingDirectory=/opt/aroma
EnvironmentFile=/opt/aroma/.env
ExecStart=/opt/aroma/.venv/bin/uvicorn miniapp_server:app --host 127.0.0.1 --port 8091 --workers 2
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target

[Unit]
Description=n8n Workflow Automation (aroma-bot)
After=docker.service
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStartPre=-/usr/bin/docker rm -f n8n-aroma
ExecStart=/usr/bin/docker run --rm \
  --name n8n-aroma \
  -p 127.0.0.1:5678:5678 \
  -v n8n_data:/home/node/.n8n \
  -e N8N_BASIC_AUTH_ACTIVE=true \
  -e N8N_BASIC_AUTH_USER=admin \
  -e N8N_BASIC_AUTH_PASSWORD=${N8N_BASIC_AUTH_PASSWORD} \
  -e N8N_PAYLOAD_SIZE_MAX=64 \
  -e WEBHOOK_URL=http://127.0.0.1:5678/ \
  n8nio/n8n:latest
ExecStop=/usr/bin/docker stop n8n-aroma
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

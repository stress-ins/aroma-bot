#!/bin/bash
# Only checkout files — all restarts and migrations are handled by
# the GitHub Actions deploy workflow (.github/workflows/deploy.yml).
# This prevents double-restart and the ~60s downtime window.
echo '=== post-receive: checkout only ==='
GIT_WORK_TREE=/opt/aroma GIT_DIR=/opt/aroma.git git checkout -f main
echo '=== post-receive: done ==='

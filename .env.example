# ── Required ──────────────────────────────────────────────
# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Chat ID to send daily digest to (use @userinfobot to find yours)
REPORT_TARGET_CHAT_ID=

# ── Phase 1: Recommended ──────────────────────────────────
# YouTube Data API v3 (console.cloud.google.com → APIs & Services)
YOUTUBE_API_KEY=

# Reddit app credentials (reddit.com/prefs/apps → create "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional: your Reddit username/password for higher rate limits
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ── Phase 2: Optional ─────────────────────────────────────
# Telegram user account (my.telegram.org) for channel monitoring
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Comma-separated list of public channel usernames to monitor
TELEGRAM_CHANNELS=aromaworld,soundhealing_ru

# Twitter/X Bearer Token (developer.twitter.com)
TWITTER_BEARER_TOKEN=

# Instagram credentials for instaloader (use a secondary account!)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Threads API
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_USERNAME=

# Mini App aromas access
# Add your Telegram user id here. Wife id 247982221 is allowed in code by default.
MINIAPP_AROMA_ALLOWED_USER_IDS=

# ── Image Generation ──────────────────────────────────────
# Kie.ai API key (primary provider, kie.ai/api-key)
KIE_AI_API_KEY=
# NanoBanana API key (fallback, nanobananaapi.ai)
NANA_BANANA_API_KEY=

# ── Scheduler ─────────────────────────────────────────────
# Daily digest time in HH:MM format (24h, Moscow time UTC+3)
DAILY_DIGEST_TIME=09:00

# Timezone for scheduler
TIMEZONE=Europe/Moscow

# ── Cache ─────────────────────────────────────────────────
# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600
